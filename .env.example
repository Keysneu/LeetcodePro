# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_AI_BASE_URL=http://localhost:8000

# API
API_PORT=3001
API_CORS_ORIGIN=http://localhost:3000
# Admin console API key (used by /api/admin/* endpoints and web admin page server-side fetch)
ADMIN_API_KEY=leetcodepro-admin-key

# AI Tutor
AI_TUTOR_PORT=8000
AI_TUTOR_BASE_URL=http://localhost:8000
LLM_PROVIDER=vllm
VLLM_BASE_URL=http://127.0.0.1:18100/v1
VLLM_API_KEY=asjjcjasldasdasdcasd
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
CHAT_TEMPLATE_TYPE=qwen
VLLM_TIMEOUT_SECONDS=20
VLLM_MAX_TOKENS=512
VLLM_TEMPERATURE=0.2

# Judge Dispatcher
JUDGE_PORT=8080
JUDGE_EXECUTOR_MODE=docker
JUDGE_CASE_TIMEOUT_MS=2000
JUDGE_COMPILE_TIMEOUT_MS=6000
JUDGE_SANDBOX_STARTUP_GRACE_MS=8000
JUDGE_DOCKER_CPP_IMAGE=gcc:13-bookworm
JUDGE_DOCKER_PYTHON_IMAGE=python:3.12-slim
JUDGE_SANDBOX_MEMORY_LIMIT=256m
JUDGE_SANDBOX_CPU_LIMIT=1.0
JUDGE_SANDBOX_PIDS_LIMIT=64
JUDGE_SANDBOX_TMPFS_SIZE=64m
JUDGE_SANDBOX_CONTAINER_USER=65534:65534
# Optional custom seccomp profile path.
# Leave empty to auto-use built-in profile: infra/seccomp/judge-seccomp.json
# Set to "off" to disable custom seccomp profile.
JUDGE_DOCKER_SECCOMP_PROFILE=

# Infrastructure
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/leetcodepro
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672
JUDGE_QUEUE_NAME=judge.submissions.v1
